# Copy to .env.local and fill in. Never commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=https://localhost:7203/api

# Session signing key. Generate with: npx auth secret
AUTH_SECRET=

# Shared secret proving to the API that a caller is this front end.
# Must match Auth:BffSharedSecret in the API's user-secrets.
#
# It guards only the SSO exchange endpoint, which mints a session from a provider
# subject rather than a credential — so anything holding it can sign in as anyone.
API_BFF_SECRET=

# Who may sign in.
#   allowlist (default) — only addresses in AUTH_ALLOWED_EMAILS below
#   open                — anyone who registers gets their own tenant
#
# Left unset it stays closed, so opening sign-up is a deliberate choice rather
# than something that happens by clearing a variable.
AUTH_SIGNUP_MODE=allowlist

# Comma-separated allowlist, used only while AUTH_SIGNUP_MODE=allowlist.
# Leaving it empty means nobody can sign in (fail closed).
AUTH_ALLOWED_EMAILS=you@example.com

# Google OAuth "Web application" client credentials.
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional additional provider.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
