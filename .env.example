# Copy to .env.local and fill in. Never commit real secrets.

NEXT_PUBLIC_APP_URL=http://localhost:3000
API_URL=https://localhost:7203/api

# Session signing key. Generate with: npx auth secret
AUTH_SECRET=

# Google OAuth "Web application" client credentials.
# Authorized redirect URI: <NEXT_PUBLIC_APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated allowlist. SSO proves identity, this grants access.
# Leaving it empty means nobody can sign in (fail closed).
AUTH_ALLOWED_EMAILS=you@example.com

# Optional additional provider.
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=
